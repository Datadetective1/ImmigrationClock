# ---------------------------------------------------------------------------
# ImmigrationClock environment variables
# Copy this file to ".env" and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma and the Python ingestion scripts.
# Local example:
#   postgresql://postgres:postgres@localhost:5432/immigration_clock?schema=public
# Vercel/Neon/Supabase: paste the pooled connection string they provide.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/immigration_clock?schema=public"

# Optional direct (non-pooled) URL — used by `prisma migrate`/`prisma db push`
# when DATABASE_URL points at a pooled connection (PgBouncer). Safe to leave
# equal to DATABASE_URL for a plain local Postgres.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/immigration_clock?schema=public"

# Public site URL — used for canonical URLs, sitemap.xml, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense publisher id (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# Leave empty — until set, the ad slots render the Immigration Pulse newsletter
# signup instead of an empty placeholder. Set this to switch those slots to ads.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# ---------------------------------------------------------------------------
# REVENUE: affiliate / partner links (see src/lib/partners.ts and /resources).
# The "Helpful services" modules and the /resources page link to services
# newcomers use (immigration legal help, money transfer, nonresident tax,
# newcomer banking, insurance, eSIM). Out of the box they point to each
# service's homepage. To EARN, map partner ids -> your tracked affiliate/
# referral URLs as a JSON object (no code changes needed). Any id you omit
# keeps its homepage default. Partner ids: boundless, attorney-match, wise,
# remitly, sprintax, resident-tax, newcomer-credit, newcomer-insurance, esim,
# citizenship-prep.
#   Example:
#   NEXT_PUBLIC_PARTNER_LINKS={"wise":"https://wise.com/invite/abc","sprintax":"https://www.sprintax.com/?ref=you"}
NEXT_PUBLIC_PARTNER_LINKS=""

# Optional "tip jar" — a Buy Me a Coffee / Ko-fi / GitHub Sponsors URL. When set,
# a "♥ Support this project" link appears in the footer. Hidden until configured.
NEXT_PUBLIC_SUPPORT_URL=""

# Newsletter ("Immigration Pulse") subscribe endpoint. Set this to your email
# provider's subscribe URL — Buttondown, Mailchimp, ConvertKit, Formspree, etc.
# (the form POSTs `email` to it). Until set, the signup shows a "coming soon"
# state and never pretends to capture an address it can't store.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=""

# When "true", pages read live data from PostgreSQL via Prisma.
# When unset/"false", pages render from the bundled sample dataset so the app
# works immediately without a database. The MVP ships with this off.
USE_DATABASE="false"

# Simple shared secret protecting /admin pages and the refresh API (optional).
ADMIN_TOKEN=""
