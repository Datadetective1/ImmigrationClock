{
  "name": "immigration-clock",
  "version": "1.0.0",
  "private": true,
  "description": "The Immigration Clock — live and latest available public data on U.S. immigration enforcement, visas, border activity, and workforce impact.",
  "scripts": {
    "dev": "next dev",
    "refresh": "node scripts/refresh-data.mjs",
    "backfill:history": "node scripts/backfill-history.mjs",
    "build:data": "tsx scripts/build-dataset.ts",
    "build:pulse-email": "tsx scripts/build-pulse-email.ts",
    "prebuild": "node scripts/refresh-data.mjs && tsx scripts/build-dataset.ts && tsx scripts/build-pulse-email.ts",
    "build": "next build",
    "build:db": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate || exit 0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^11.11.17",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
