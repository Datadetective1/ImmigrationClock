{
  "name": "immigration-clock",
  "version": "1.0.0",
  "private": true,
  "description": "The Immigration Clock \u2014 live and latest available public data on U.S. immigration enforcement, visas, border activity, and workforce impact.",
  "scripts": {
    "dev": "next dev",
    "refresh": "node scripts/refresh-data.mjs",
    "backfill:history": "node scripts/backfill-history.mjs",
    "build:data": "tsx scripts/build-dataset.ts && tsx scripts/build-newsletter.ts",
    "build:employers": "tsx scripts/build-employers.ts",
    "build:warn": "tsx scripts/build-warn.ts",
    "build:events": "tsx scripts/build-events.ts",
    "build:newsletter": "tsx scripts/build-newsletter.ts",
    "send:newsletter": "tsx scripts/send-newsletter.ts",
    "refresh:warn-scraper": "node scripts/refresh-warn-scraper.mjs",
    "prebuild": "node scripts/refresh-data.mjs && tsx scripts/build-employers.ts && tsx scripts/build-warn.ts && tsx scripts/build-events.ts && tsx scripts/build-dataset.ts && tsx scripts/build-newsletter.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
